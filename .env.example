# ============================================================
# PAPSE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores.
# NUNCA commite o arquivo .env!
# ============================================================

# ------ Servidor ------
PORT=3000
NODE_ENV=development

# ------ Banco de Dados (Prisma) ------
# Use o hostname "db" quando rodar via Docker Compose
DATABASE_URL=mysql://docker_user:docker_password@db:3306/papse_db

# ------ MySQL (para o container do banco) ------
MYSQL_ROOT_PASSWORD=troque_pela_senha_root
MYSQL_DATABASE=papse_db
MYSQL_USER=docker_user
MYSQL_PASSWORD=docker_password

# ------ JWT ------
# Gere um secret forte: node -e "require('crypto').randomBytes(64).toString('hex')|Write-Host"
JWT_SECRET=troque_por_um_secret_forte_de_no_minimo_64_caracteres

# ------ CORS ------
FRONTEND_URL=http://localhost:8080

# ------ reCAPTCHA (backend) ------
RECAPTCHA_SECRET_KEY=coloque_a_chave_secreta_do_recaptcha

# ------ E-mail (nodemailer) ------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua_senha_de_app_gmail

# ------ Frontend (Vite) ------
# Apontado para a API local (via Docker ou host)
VITE_API_URL=http://localhost:3000/api

# ------ Admin inicial (script create-admin) ------
ADMIN_NOME=Administrador Local
ADMIN_EMAIL=admin@exemplo.com
ADMIN_MATRICULA=admin001
ADMIN_PASSWORD=troque_por_senha_forte

# ------ Política de Retenção de Auditoria ------
# Número de dias que os logs de auditoria serão mantidos antes da exclusão automática.
# 730 dias = 24 meses (padrão LGPD recomendado para sistemas de saúde).
# O Job executa diariamente às 02:00 (America/Sao_Paulo).
AUDIT_LOG_RETENTION_DAYS=730
